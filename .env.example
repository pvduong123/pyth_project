APP_NAME=Python SaaS Starter
APP_ENV=development
SECRET_KEY=change-this-in-production-with-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/saas_starter
COOKIE_NAME=saas_session
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8000
